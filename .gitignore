###############################################################################
# Global .gitignore for FinanceApp
# This file covers both the backend (FastAPI) and frontend (React).
# It ensures sensitive files, local dependencies, build outputs, logs,
# and virtual environments are never committed to the repository.
###############################################################################

###############################################################################
# Logs
###############################################################################
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

###############################################################################
# Node.js (Frontend & Build Tools)
###############################################################################
# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build outputs
dist/
dist-ssr/
*.local

###############################################################################
# Environment Variables
# These files contain secrets and should NEVER be committed.
###############################################################################
.env
.env.local
.env.*.local
*.env

###############################################################################
# Python (Backend)
###############################################################################
# Virtual environments
venv/
.venv/
env/
ENV/

# Python cache files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Database
*.db
*.sqlite
*.sqlite3

# Pytest
.pytest_cache/
.coverage
htmlcov/

###############################################################################
# IDEs and Editors
###############################################################################
.vscode/*               # VS Code configs (ignored)
!.vscode/extensions.json # But keep recommended extensions
.idea/                  # JetBrains IDE configs
.DS_Store               # macOS Finder metadata
*.suo                   # Visual Studio files
*.ntvs*                 # Node Tools for Visual Studio
*.njsproj               # Node.js project files
*.sln                   # Visual Studio solution files
*.sw?                   # Vim swap files

###############################################################################
# End of .gitignore
###############################################################################

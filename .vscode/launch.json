{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Uvicorn (FastAPI)",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/financeApp/backend/venv/bin/uvicorn",
      "args": ["main:app", "--reload", "--host", "0.0.0.0", "--port", "8000"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/financeApp/backend",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/financeApp/backend"
      }
    }
  ]
}

{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Uvicorn (backend)",
      "type": "shell",
      "command": "source ${workspaceFolder}/financeApp/backend/venv/bin/activate && uvicorn main:app --reload --host 0.0.0.0 --port 8000",
      "options": { "cwd": "${workspaceFolder}/financeApp/backend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Run Vite (frontend)",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/financeApp/frontend" },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
